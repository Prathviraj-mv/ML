import pandas as pd
import seaborn as sns

data = pd.read_csv("social_media_viral_content_dataset.csv")
data.drop(columns="post_id",inplace=True)


from sklearn.preprocessing import LabelEncoder
for col in data.columns:
    if data[col].dtype == "object":
        en =LabelEncoder()
        data[col] = en.fit_transform(data[col])


corr =data.corr()["is_viral"].sort_values(ascending=True)
print(corr)


import matplotlib.pyplot as plt
sns.jointplot(data=data,x ="views",y="likes",hue="is_viral")

plt.figure(figsize=(10,15))
sns.jointplot(data=data,x ="views",y="hashtags",hue="is_viral")

plt.figure(figsize=(10,15))
sns.jointplot(data=data,x ="views",y="comments",hue="is_viral")

plt.figure(figsize=(10,15))
sns.jointplot(data=data,x ="comments",y="likes",hue="is_viral")



from sklearn.metrics import accuracy_score,precision_score,classification_report,confusion_matrix
from sklearn.model_selection import train_test_split,GridSearchCV
from sklearn.ensemble import RandomForestClassifier

import xgboost as xgb

X =data.drop(columns=["is_viral","views","likes","comments","shares","engagement_rate","sentiment_score"])
y = data["is_viral"]

xgb_model = xgb.XGBClassifier(
    tree_method="hist",
    device="cuda",
    objective="binary:logistic",
    eval_metric="logloss"
)

param_grid = {
    "n_estimators": [200, 300],
    "max_depth": [4, 6, 8],
    "learning_rate": [0.05, 0.1],
    "subsample": [0.8, 1.0],
    "colsample_bytree": [0.8, 1.0]
}

grid = GridSearchCV(
    estimator=xgb_model,
    param_grid=param_grid,
    scoring="accuracy",
    cv=3,
    verbose=2,
    n_jobs=1
)

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.33, random_state=42)
grid.fit(X_train,y_train)

model =grid.best_estimator_

prediction = model.predict(X_test)

print(round(accuracy_score(y_true=y_test,y_pred=prediction),2))
print(round(precision_score(y_true=y_test,y_pred=prediction),2))
print(classification_report(y_true=y_test,y_pred=prediction))
print(confusion_matrix(y_test,prediction))



